# Point this app at a real site. Copy to `.env.local`; without it every call rejects and the
# page renders its empty state, which is the intended default for the template preview.
#
# Read by `@estoreclub/api`, which configures its client from the environment once. Server-side
# only: `COMPANY_API_KEY` is a secret, so nothing here may be read from a `"use client"` file.

# The API.
NEXT_PUBLIC_SERVER_URL=http://localhost:4000

# This site's OWN key, sent as `x-company-api-key`. The ONLY credential involved: every public
# route authenticates with it and the server resolves the company from it, so there is no
# domain to configure and no platform key in this process.
#
# `lib/configureApi.ts` also hands it to the client explicitly, which is what a host does when
# it resolves the key at runtime rather than reading it here.
COMPANY_API_KEY=

# Read a product sample INSTEAD of this company's own catalogue — its slug, the same id
# `template.json` names as `productSampleId`. This site was designed around the TechStore catalogue,
# so that is what it shows until the shop has written its own; leave empty to read the shop's.
# Site name, languages and currency still come from the company. Checkout is refused while a
# sample is shown — the basket works, nobody can pay for it.
COMPANY_SAMPLE_PRODUCTS=sample-tech
